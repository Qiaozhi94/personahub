# Editor / tooling artifacts
.history/
.claude/settings.local.json
.claude/worktrees/
.sisyphus/
.omo/
.playwright-mcp/

# Local SQLite runtime files
*.db
*.db-shm
*.db-wal

# Local runtime artifacts (dev DB, logs)
.local/

# Dependencies
node_modules/

# Environment / secrets
.env
.env.local
.env.*.local

# Build output
dist/
build/
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
server-stdout.txt
server-stderr.txt

# 注：docs/ 下不再有本地-only 目录。2026-08-12 起 docs/reviews/ 与 docs/research/
# 全部纳入 git——检视记录、dogfood 日志、产品级计划和调研结论都需要可追溯、可 diff、
# 可在多机之间同步；本地-only 让复盘时拿不到当时的原始判断和证据来源。

# Probe raw output streams
server/scripts/codex-probe-*.jsonl

# Playwright E2E runtime artifacts (browsers themselves live outside the
# repo, in the OS-level Playwright cache — nothing binary to ignore there)
e2e/.tmp/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/

# ESLint incremental cache (npm run lint --cache); local-only, machine-specific
.eslintcache
