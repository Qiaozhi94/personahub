# Editor / tooling artifacts
.history/
.claude/settings.local.json
.claude/worktrees/
.sisyphus/
.playwright-mcp/

# Local SQLite runtime files
*.db
*.db-shm
*.db-wal

# Local runtime artifacts (dev DB, logs)
.local/

# Dependencies
node_modules/

# Environment / secrets
.env
.env.local
.env.*.local

# Build output
dist/
build/
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
server-stdout.txt
server-stderr.txt

# Local-only docs (kept on disk, not tracked)
docs/research/
docs/reviews/*
# ...except the curated, permanent summaries the review-convergence skill
# produces — these are meant to be committed, unlike raw per-round scratch files.
!docs/reviews/RETROSPECTIVE.md
!docs/reviews/CURRENT-doc.md
!docs/reviews/dogfooding-bugs.md
!docs/reviews/CURRENT-code.md

# Probe raw output streams
server/scripts/codex-probe-*.jsonl

# Playwright E2E runtime artifacts (browsers themselves live outside the
# repo, in the OS-level Playwright cache — nothing binary to ignore there)
e2e/.tmp/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
