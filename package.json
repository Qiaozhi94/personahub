{
  "name": "personahub",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web",
    "e2e"
  ],
  "scripts": {
    "predev": "npm -w @personahub/shared run build",
    "dev": "npm run dev:server & npm run dev:web",
    "dev:server": "npm -w @personahub/server run dev",
    "dev:web": "npm -w @personahub/web run dev",
    "build": "npm run build:shared && npm run build:server && npm run build:web",
    "build:shared": "npm -w @personahub/shared run build",
    "build:server": "npm -w @personahub/server run build",
    "build:web": "npm -w @personahub/web run build",
    "pretest": "npm run build:shared",
    "test": "npm -w @personahub/server run test && npm -w @personahub/web run test",
    "lint": "eslint server shared web e2e eslint.config.js",
    "format": "prettier --write \"eslint.config.js\" \"package.json\" \"server/src/services/{adapter-config*,adapter-failure-reprobe,run-dispatch,run-escalation-handler}.ts\" \"server/src/services/validation/{context-builder,evidence-summary-builder,evidence-summary-contract,issue-blocker,non-pass-processor,result-parser,result-parser-contract,result-parser-fields,result-processor,validator-envelope-contract,validator-slot-claimer,workflow-service}.ts\" \"web/src/{App.tsx,test/api-client-mock.ts,components/adapter/*.{ts,tsx}}\"",
    "format:check": "prettier --check \"eslint.config.js\" \"package.json\" \"server/src/services/{adapter-config*,adapter-failure-reprobe,run-dispatch,run-escalation-handler}.ts\" \"server/src/services/validation/{context-builder,evidence-summary-builder,evidence-summary-contract,issue-blocker,non-pass-processor,result-parser,result-parser-contract,result-parser-fields,result-processor,validator-envelope-contract,validator-slot-claimer,workflow-service}.ts\" \"web/src/{App.tsx,test/api-client-mock.ts,components/adapter/*.{ts,tsx}}\"",
    "pretypecheck": "npm run build:shared",
    "typecheck": "npm -w @personahub/server run typecheck && npm -w @personahub/web run typecheck && npm -w @personahub/e2e run typecheck",
    "pretest:e2e": "npm run build:shared",
    "test:e2e": "npm -w @personahub/e2e run test",
    "test:e2e:install": "npm -w @personahub/e2e exec playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
